DEAN_DOMAIN=dean.example.org

# DeepSeek напрямую или через OpenRouter / RouterAI. Укажи только свои ключи.
DEAN_AI_PROVIDER=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
DEAN_AI_API_KEY=
DEAN_DEEPSEEK_CHAT_MODEL=deepseek-flash
DEAN_AI_DAILY_LIMIT=100
DEAN_AI_TOTAL_LIMIT=300
DEAN_PRIVACY_REQUIRE_CONSENT=0
DEAN_PRIVACY_OPERATOR=
DEAN_PRIVACY_ADDRESS=
DEAN_PRIVACY_EMAIL=
DEAN_PRIVACY_AUTH_BASIS=
DEAN_PRIVACY_RETENTION=
DEAN_PRIVACY_PROCESSORS=
DEAN_PRIVACY_TRANSFER=

DEAN_YANDEX_CLIENT_ID=
DEAN_YANDEX_CLIENT_SECRET=
DEAN_VK_CLIENT_ID=
DEAN_MAX_BOT_USERNAME=
DEAN_MAX_BOT_TOKEN=
DEAN_PASSKEYS=1

# Точные имена доверенных хостов видео через запятую. Пустое значение отключает обработку ссылок.
DEAN_LECTURE_IMPORT_HOSTS=interactive-examples.mdn.mozilla.net,media.w3.org,upload.wikimedia.org
DEAN_LECTURE_PUBLIC_LINKS=1

DEAN_INSTALL_FIELD=1
DEAN_FIELD_REMOTE=1
DEAN_EXT_CAMPUS_PAY=1
DEAN_EXT_ROOM_OCCUPANCY=1
DEAN_ROOM_OCCUPANCY_CAMERA=0

DEAN_TELEGRAM_MODE=off
DEAN_TELEGRAM_BOT_USERNAME=
DEAN_TELEGRAM_BOT_TOKEN=
DEAN_TELEGRAM_ALLOWED_CHAT_IDS=
DEAN_TELEGRAM_PUBLIC=0
